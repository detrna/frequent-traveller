# Salin ke .env.local lalu sesuaikan:  cp .env.example .env.local

# --- Database ---------------------------------------------------------------
# Pilih database yang dipakai aplikasi: "local" (docker compose) atau "cloud" (Prisma Postgres).
DB_TARGET=local

# Database lokal dari docker-compose.yml (port host 5433 agar tidak bentrok dengan Postgres lain di 5432).
DATABASE_URL_LOCAL=postgresql://aps:aps@localhost:5433/aps

# Database untuk tes integrasi (dibuat otomatis oleh docker/initdb).
DATABASE_URL_TEST=postgresql://aps:aps@localhost:5433/aps_test

# Maks. koneksi per instans aplikasi (default 5). Di serverless/Vercel biarkan kecil.
# DB_POOL_MAX=5

# Prisma Postgres (cloud). Isi dengan URL koneksi langsung "postgres://..." dari dashboard Prisma,
# BUKAN URL "prisma+postgres://" (Accelerate). Kosongkan selama belum dipakai.
DATABASE_URL_CLOUD=

# --- Auth.js ----------------------------------------------------------------
# Buat dengan:  npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=
# Wajib di produksi: https://frequent-traveller.vercel.app (Vercel). Lokal boleh dikosongkan.
AUTH_URL=
# Hanya untuk produksi di luar Vercel (Vercel dipercaya otomatis): AUTH_TRUST_HOST=true

# --- E-tiket (email) ----------------------------------------------------------
# "smtp" = kirim ke Mailpit lokal (UI: http://localhost:8025) | "resend" = Resend API (produksi)
EMAIL_DRIVER=smtp
EMAIL_FROM="APS <no-reply@aps.test>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
